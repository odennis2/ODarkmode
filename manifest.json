{
  "manifest_version": 3,
  "name": "ODarkMode",
  "version": "0.4.0",
  "description": "A dark mode extension for the web.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ODarkMode",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/smart.js", "content/darkmode.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"]
}
